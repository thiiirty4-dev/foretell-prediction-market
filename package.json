{
  "name": "forecast-amoy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:test": "forge test --root contracts -vvv",
    "indexer": "tsx --env-file-if-exists=.env.local worker/indexer.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:init": "npm run db:migrate && npm run db:seed",
    "db:check": "tsx scripts/check-migrations.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run db:check",
    "dev:vinext": "vinext dev",
    "build:vinext": "vinext build",
    "deploy": "vinext build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-generated-env.d.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.39.0",
    "@privy-io/server-auth": "1.32.5",
    "@solana-program/system": "0.8.0",
    "@solana-program/token": "0.6.0",
    "@solana/kit": "3.0.3",
    "@supabase/supabase-js": "2.114.0",
    "decimal.js": "10.6.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "solc": "0.8.28",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.0.13",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
